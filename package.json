{
  "name": "code2",
  "version": "0.1.0",
  "type": "module",
  "description": "对上了 - 单局文字组对·语义构筑（微信/抖音小游戏）",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "vite build",
    "build:wechat": "CODE2_PLATFORM=wechat vite build",
    "build": "npm run typecheck && npm run test && vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^7.3.2",
    "pixi.js": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  }
}
